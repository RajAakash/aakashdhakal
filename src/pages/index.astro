---
import BaseLayout from '../layouts/base-layout.astro';
import Contacts from '../components/contact.astro';
import IndexNav from '../components/index-nav.astro';
import Research from '../sections/research.astro';
import Experience from '../sections/experience.astro';
import Projects from '../sections/projects.astro';
import Publications from '../sections/publications.astro';
import Writing from '../sections/writing.astro';
import Education from '../sections/education.astro';
import News from '../sections/news.astro';
---

<BaseLayout
  title="Aakash Raj Dhakal · HPC & Machine Learning Researcher"
  description="Doctoral researcher in High-Performance Computing and Machine Learning at Texas State University, collaborating with Lawrence Livermore National Laboratory on HPC performance prediction and optimization."
>
  <IndexNav />

  <main>
    <section id="home">
      <div class="intro-panel">
        <h1 class="heading heading-hero">Aakash Raj Dhakal</h1>

        <p class="subheading">Ph.D. Candidate in Computer Science · Texas State University</p>

        <p class="intro-text">
          I'm a Ph.D. candidate at Texas State University, advised by Dr. Tanzima Islam. I work on
          machine learning for HPC: predicting how an application will perform on a supercomputer
          it has never run on. I've spent two summers at Lawrence Livermore National Laboratory
          working on this, and my work has appeared at CCGrid, HPDC and COMPSAC.
        </p>

        <div class="hero-cta">
          <a
            href="/aakash-dhakal-resume.pdf"
            target="_blank"
            rel="noopener"
            class="cta-button cta-primary"
            data-cursor="hover"
          >
            Download CV
          </a>
        </div>

        <Contacts />

        <div class="stack-panel">
          <div class="stack-grid">
            <span>Python</span>
            <span>PyTorch</span>
            <span>TensorFlow</span>
            <span>MPI / SLURM</span>
            <span>Deep Learning</span>
            <span>Transformers</span>
            <span>Generative Models</span>
            <span>Statistics & Optimization</span>
          </div>
        </div>
      </div>
    </section>

    <div class="divider" aria-hidden="true"></div>

    <section id="news">
      <header class="section-header">
        <h2 class="heading heading-section">News</h2>
      </header>
      <News />
    </section>

    <div class="divider" aria-hidden="true"></div>

    <section id="research">
      <header class="section-header">
        <h2 class="heading heading-section">Research</h2>
      </header>
      <Research />
    </section>

    <div class="divider" aria-hidden="true"></div>

    <section id="experience">
      <header class="section-header">
        <h2 class="heading heading-section">Experience</h2>
      </header>
      <Experience />
    </section>

    <div class="divider" aria-hidden="true"></div>

    <section id="projects">
      <header class="section-header">
        <h2 class="heading heading-section">Projects</h2>
      </header>
      <Projects />
    </section>

    <div class="divider" aria-hidden="true"></div>

    <section id="publications">
      <header class="section-header">
        <h2 class="heading heading-section">Publications</h2>
      </header>
      <Publications />
    </section>

    <div class="divider" aria-hidden="true"></div>

    <section id="education">
      <header class="section-header">
        <h2 class="heading heading-section">Education</h2>
      </header>
      <Education />
    </section>

    <div class="divider" aria-hidden="true"></div>

    <section id="writing">
      <header class="section-header">
        <h2 class="heading heading-section">Writing</h2>
        <p class="subheading">Notes from Medium</p>
      </header>
      <Writing />
    </section>
  </main>

  <footer class="site-footer">
    <p class="footer-note">
      Happy to talk about HPC, machine learning, or a paper you think I should read. Email me at <a href="mailto:aakashrajdhakal@gmail.com" data-cursor="hover">aakashrajdhakal@gmail.com</a>.
    </p>

    <div class="footer-meta">
      <span>© {new Date().getFullYear()} Aakash Raj Dhakal</span>
      <span>San Marcos, Texas</span>
    </div>
  </footer>
</BaseLayout>
